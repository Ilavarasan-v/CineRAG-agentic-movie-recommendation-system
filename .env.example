# ── Local MongoDB ──────────────────────────────────────────────────
# Default works if MongoDB is running locally with no auth
MONGO_URI=mongodb://localhost:27017/

# ── OpenAI (required) ──────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── ChromaDB path (optional — defaults to ./chroma_db) ────────────
# CHROMA_PATH=./chroma_db

# ── Optional: Cohere reranker (free tier at cohere.com) ───────────
COHERE_API_KEY=

# ── Optional: Tavily web search fallback (free at tavily.com) ─────
TAVILY_API_KEY=
